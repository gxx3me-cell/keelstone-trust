# Copy to .env.local and fill in from your Supabase project
# (Dashboard → Project Settings → API Keys).
#
# Vite only exposes vars prefixed with VITE_ to the browser bundle.
# Both values below are safe to ship to the client — the publishable key
# grants no access by itself; Row Level Security decides what each user
# can read and write.
#
# The secret key (sb_secret_...) bypasses RLS and must NEVER appear here,
# in any VITE_ var, or anywhere in the frontend. It belongs only in Edge
# Function secrets: `supabase secrets set ...`
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
